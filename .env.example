# Copy this file to .env.local (gitignored) and fill in your real key(s).
# Only used by the native (iOS/Android) build — see src/services/mealGenerator.native.ts.
EXPO_PUBLIC_MAX_POWER_KEY=

# Free key from https://www.yelp.com/developers/v3/manage_app — powers live
# restaurant search on the Explore tab. Native only (Yelp has no CORS
# headers, so it can't be called from the web build) — see
# src/services/restaurantFinder.native.ts. Without this, Explore falls back
# to a bundled sample list.
EXPO_PUBLIC_YELP_API_KEY=
